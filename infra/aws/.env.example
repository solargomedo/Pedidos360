# Administrador PostgreSQL existente. No lo usan Orders ni Catalog.
POSTGRES_USER=pedidos360_admin
POSTGRES_PASSWORD=

# Claves EXISTENTES de los roles de aplicacion, ya creados y verificados.
# Catalog usa pedidos360_catalog_app; Orders usa pedidos360_orders_app.
CATALOG_DB_PASSWORD=
ORDERS_DB_PASSWORD=

# Identidad NUEVA exclusiva del RabbitMQ de integracion.
# Proporcionar un usuario distinto de guest y de los usuarios del cluster original.
# No usar / ni pedidos360-dlq-test como vhost de esta prueba independiente.
INTEGRATION_RABBITMQ_USER=
INTEGRATION_RABBITMQ_PASSWORD=
INTEGRATION_RABBITMQ_VHOST=
